# Copy this file to .env and update with your SMTP credentials.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_TO=your-receive-email@example.com

# Frontend API base URL: usually left blank in development if using Vite proxy.
VITE_API_BASE_URL=http://localhost:4000

# EmailJS configuration for client-side contact form
VITE_EMAILJS_SERVICE_ID=service_yji0zwf
VITE_EMAILJS_TEMPLATE_ID=template_48wa0z7
VITE_EMAILJS_PUBLIC_KEY=9umbRECjLM1mKTa85

# Contact server port
PORT=4000
